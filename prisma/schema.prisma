// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(uuid())
  name                  String?
  email                 String?        @unique
  password              String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  isAdmin               Boolean        @default(false)
  universityId          String         @unique
  lastActiveAt          DateTime?      @default(now())
  lastActiveWorkspaceId String?        @unique
  invitesSent           Invite[]       @relation("InvitesSentBy")
  joinRequests          JoinRequest[]
  memberships           Member[]
  notifications         Notification[]
  createdRoles          Role[]         @relation("RoleCreatedBy")
  updatedRoles          Role[]         @relation("RoleUpdatedBy")
  sessions              Session[]
  EventParticipants    EventParticipant[]
  createdEvents        Event[]        @relation("CreatedEvents")
  lastActiveEvents UserLastActiveEvent[] 
TasksCreated         Task[]         @relation("TaskCreatedBy")
  lastActiveWorkspace   Workspace?     @relation("UserLastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id])
  TaskAssignees        TaskAssignee[]
  TaskComments         TaskComment[]
  TaskRoles            TaskRole[]
  EventInterest        EventInterest[]

  enrolledEvents      EventEnrollment[]
  teamsLed    Team[] 
  TeamMembers         TeamMember[]
  createdWorkspaces     Workspace[]    @relation("UserCreatedWorkspaces")
}

model Workspace {
  id              String         @id @default(uuid())
  name            String
  createdById     String
  allowAutoJoin   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  slug            String         @unique
  invites         Invite[]
  joinRequests    JoinRequest[]
  members         Member[]
  notifications   Notification[]
  roles           Role[]
  events          Event[]
  EventRoles      EventRole[]
  lastActiveUsers User?          @relation("UserLastActiveWorkspace")
  createdBy       User           @relation("UserCreatedWorkspaces", fields: [createdById], references: [id], onDelete: Cascade)
   lastActiveEvents UserLastActiveEvent[]
   Tasks          Task[]
   eventParticipants EventParticipant[]
   teams         Team[]
   enrolledEvents  EventEnrollment[]
}

model Member {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  roleId      String
  joinedAt    DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy   User             @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     Member[]
  Invite      Invite[]
  JoinRequest JoinRequest[]

  @@unique([workspaceId, name])
}

model PermissionCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
}

model Permission {
  id              String             @id @default(cuid())
  name            String             @unique
  label           String
  categoryId      String
  category        PermissionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
   eventRolePermissions     EventRolePermission[]
   TaskRolePermissions    TaskRolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Invite {
  id    String @id @default(uuid())
  token String @unique

  // Used only for one-time email invites
  email        String? // optional for public invites
  name         String? // optional for public invites
  universityId String? // optional for public invites

  // Keep track of everyone who joined using this link
  joinedEmails String[] @default([])

  isLink     Boolean      @default(false) // true = link invite, false = email invite
  status     InviteStatus @default(PENDING)
  linkPublic Boolean      @default(false)
  disabled   Boolean      @default(false)
  usedAt     DateTime? // only for one-time email invite
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  // Relations
  invitedById String
  roleId      String
  workspaceId String

  invitedBy User      @relation("InvitesSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model JoinRequest {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  roleId      String
  createdAt   DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Session {
  id             String   @id @default(cuid()) @map("_id")
  userId         String
  token          String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  message     String
  workspaceId String?
  read        Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Event {
  id              String       @id @default(cuid())
  name            String
  slug            String?        // SEO & shareable links, e.g. /events/techfest-2025
  description     String?
  location        String?
  isOnline        Boolean       @default(false)
  eventLink       String?       // For online events
  bannerUrl       String?       // Main banner or poster image
  galleryUrls     String[]      // Additional images

  isTeamEvent     Boolean       @default(false)   // true → team-based, false → solo
  minTeamSize     Int?                            // optional, only for team events
  maxTeamSize     Int?                            // optional, only for team events

  startDate       DateTime
  endDate         DateTime?
  capacity        Int?          // Max attendees

  category        String?       // e.g. "Tech", "Cultural", "Workshop"
  tags            String[]      // e.g. ["hackathon", "AI", "college"]
  label           String?       // optional short label like “Flagship Event”

  // Engagement
  interestedCount Int           @default(0)
  enrolledCount   Int           @default(0)
  viewCount       Int           @default(0)

  // Relations
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  workspaceId     String

  createdBy       User          @relation("CreatedEvents", fields: [createdById], references: [id])
  createdById     String

  // ✅ Enrollment and Participation
  enrollments     EventEnrollment[]
  participants    EventParticipant[]
  teams           Team[]
  interestedUsers EventInterest[]

  // ✅ Roles and Tasks
  EventRoles      EventRole[]
  Tasks           Task[]
  lastActiveUsers UserLastActiveEvent[]

  // Moderation / Visibility
  status          EventStatus     @default(DRAFT)
  visibility      EventVisibility @default(PUBLIC)
  approved        Boolean         @default(false)

  // Audit fields
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?       // soft delete

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
}

model EventEnrollment {
  id             String           @id @default(cuid())
  eventId        String
  userId         String?          // for solo events
  teamId         String?          // for team events
  workspaceId    String
  status         EnrollmentStatus @default(PENDING)
  registeredAt   DateTime         @default(now())
  remarks        String?
  paymentStatus  PaymentStatus    @default(NOT_REQUIRED)
  certificateUrl String?          // optional: event completion certificate

  // Relations
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])     // prevent duplicate solo registration
  @@unique([eventId, teamId])     // prevent duplicate team registration
}

model Team {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  eventId      String
  leaderId     String        // user who created the team
  workspaceId  String
  createdAt    DateTime      @default(now())

  // Relations
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader       User          @relation(fields: [leaderId], references: [id], onDelete: Cascade)     
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  enrollments  EventEnrollment[]  // ✅ link to enrollments

  @@unique([eventId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}


enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}



// Pivot table for participants

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}


model EventInterest {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())
}

enum EventStatus {
  DRAFT
  OPEN       // users can join
  CLOSED     // event full or closed
  COMPLETED  // past event
  CANCELLED
}

enum eventJoinStatus {
  PENDING
  APPROVED
  REJECTED
}
model EventRole {
  id          String   @id @default(cuid())
  name        String
  workspaceId String   // Link role to workspace
   eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
 event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
 
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions EventRolePermission[]
  participants EventParticipant[]

  @@unique([workspaceId,eventId, name]) // No duplicate role names per workspace
}

model EventRolePermission {
  id           String      @id @default(cuid())
  roleId       String
  permissionId String

  role         EventRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model EventParticipant {
  id        String      @id @default(cuid())
  userId    String
  eventId   String
  roleId    String      // assign workspace-linked event role
  workspaceId String?     // for easier queries
  status    eventJoinStatus @default(PENDING)
  joinedAt  DateTime   @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User   @relation(fields: [userId], references: [id])
  event     Event  @relation(fields: [eventId], references: [id])
  role      EventRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model UserLastActiveEvent {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  eventId     String
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])

   @@unique([userId, workspaceId], name: "userId_workspaceId")  // one last active event per workspace
}


model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?

  // Relations
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  createdBy   User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String

  assignees   TaskAssignee[]   // Many-to-many
  comments    TaskComment[]    // Task discussions

  // 🔹 Self-relation for subtasks
  subtasks    Task[]           @relation("Subtasks")
  parentTask  Task?            @relation("Subtasks", fields: [parentTaskId], references: [id])
  parentTaskId String?

  roles       TaskRole[]       // Optional per-task roles

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TaskAssignee {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  assignedAt DateTime @default(now())
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  createdAt DateTime @default(now())
}

model TaskRole {
  id     String @id @default(cuid())
  name   String // e.g., OWNER, REVIEWER, CONTRIBUTOR

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
TaskRolePermission TaskRolePermission[]
  user   User   @relation(fields: [userId], references: [id])
  userId String

  assignedAt DateTime @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TaskRolePermission {
  id           String      @id @default(cuid())
  taskRoleId   String
  permissionId String

  taskRole     TaskRole    @relation(fields: [taskRoleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([taskRoleId, permissionId])
}
